{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "description": "Compiler-independent Remote metadata and Typert provider protocols (vendored build of the published 0.1.7-rc.1 package, see VENDOR.md)",
  "version": "0.1.7-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "sync-shims": "node scripts/sync-shims.mjs",
    "check-shims": "node scripts/sync-shims.mjs --check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.1.7-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
